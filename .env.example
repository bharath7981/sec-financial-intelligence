# =============================================================================
# SEC Financial Intelligence Engine — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# --- Database ---
DATABASE_URL=postgresql+asyncpg://secfi:secfi_dev@localhost:5432/secfi
DATABASE_URL_SYNC=postgresql://secfi:secfi_dev@localhost:5432/secfi
POSTGRES_USER=secfi
POSTGRES_PASSWORD=secfi_dev
POSTGRES_DB=secfi

# --- Qdrant ---
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=sec_chunks

# --- SEC EDGAR ---
# REQUIRED: SEC asks for a company name + email as User-Agent
SEC_USER_AGENT=MyCompany admin@mycompany.com
SEC_REQUEST_DELAY_MS=120

# --- AI Providers ---
# Gemini (default)
GEMINI_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

# OpenAI (optional alternative)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Provider selection: gemini | openai
AI_CHAT_PROVIDER=gemini
AI_EMBEDDING_PROVIDER=gemini
AI_RERANK_PROVIDER=none

# --- Retrieval ---
DENSE_TOP_K=25
SPARSE_TOP_K=25
RERANK_TOP_K=4
EMBEDDING_DIMENSIONS=768

# --- App ---
APP_ENV=development
APP_LOG_LEVEL=INFO
BACKEND_PORT=8000
FRONTEND_PORT=5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
